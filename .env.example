# BloodLink configuration. Copy to `.env` (Docker Compose) or `.env.local` (next dev) and fill in.
# Integrations are validated lazily: the app boots without email/Telegram/storage and
# shows "not configured" for those features until their variables are set.

# --- Database (MongoDB Atlas) -----------------------------------------------------------
# Connection string from Atlas → Connect → Drivers (mongodb+srv://user:pass@cluster.../).
MONGODB_URI=mongodb+srv://bloodlink:CHANGE_ME@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster.
MONGODB_DB=bloodlink

# --- Authentication (Auth.js / Google) --------------------------------------------------
# Signs session cookies and unsubscribe links. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client ID (Google Cloud Console → APIs & Services → Credentials).
AUTH_GOOGLE_ID=
# Google OAuth client secret for the client above.
AUTH_GOOGLE_SECRET=
# Optional: public base URL for Auth.js callbacks; only needed if the proxy doesn't forward Host/proto.
# AUTH_URL=https://bloodlink.example.com
# Comma-separated Google account emails that get the admin (moderator) role on sign-in.
ADMIN_EMAILS=admin@example.com

# --- Site -------------------------------------------------------------------------------
# Public URL without a trailing slash. Inlined at BUILD time (Docker build arg): rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://bloodlink.example.com
# Optional: address shown on the contact page.
CONTACT_EMAIL=hello@example.com

# --- Data protection --------------------------------------------------------------------
# AES-256-GCM key for phone numbers at rest (32 bytes, base64). Generate with: openssl rand -base64 32
# Keep it safe and stable: changing it makes every stored phone number unreadable.
DATA_ENCRYPTION_KEY=

# --- Email notifications (Brevo) --------------------------------------------------------
# Brevo → SMTP & API → API keys (v3 key starting with "xkeysib-").
BREVO_API_KEY=
# A sender address you verified in Brevo → Senders, Domains & Dedicated IPs.
BREVO_SENDER_EMAIL=alerts@example.com
# Display name for the sender.
BREVO_SENDER_NAME=BloodLink
# Max emails per day (UTC). Brevo's free plan allows 300/day; 280 leaves headroom. Default 280.
EMAIL_DAILY_LIMIT=280
# Max donors emailed per published request (same district first, then same division). Default 40.
EMAIL_MAX_RECIPIENTS_PER_REQUEST=40

# --- Telegram (private donor channel) ---------------------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Numeric id of the private channel, e.g. -1001234567890 (the bot must be an admin there).
TELEGRAM_CHANNEL_ID=
# Random 16–256 chars of A-Z a-z 0-9 _ - ; sent by Telegram as X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Bot username without "@" (enables the "Link Telegram" deep link on the account page).
TELEGRAM_BOT_USERNAME=
# Channel invite link created with "Request admin approval" (join requests) enabled.
TELEGRAM_CHANNEL_INVITE_LINK=https://t.me/+XXXXXXXXXXXX

# --- Background worker ------------------------------------------------------------------
# Bearer token the cron container sends to /api/internal/process-notifications (min 24 chars).
# Generate with: openssl rand -hex 32
NOTIFICATION_CRON_SECRET=

# --- Private document storage (S3-compatible, e.g. Cloudflare R2) ------------------------
# S3 API endpoint without the bucket, e.g. https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
# Access key id of an API token scoped to the bucket (Object Read & Write).
STORAGE_ACCESS_KEY=
# Secret access key for the token above.
STORAGE_SECRET_KEY=
# Bucket name. Keep the bucket PRIVATE: documents are only streamed through the app.
STORAGE_BUCKET=bloodlink-documents
# Region for request signing; "auto" for Cloudflare R2. Default "auto".
STORAGE_REGION=auto

# --- Multi-instance deployments (optional) ----------------------------------------------
# Same Server Actions key on every instance (16/24/32 bytes, base64); used at BUILD time.
# Generate with: openssl rand -base64 32. Not needed for a single container.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
